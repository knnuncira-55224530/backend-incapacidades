### ============================================
### 1. LISTAR TODOS LOS SEGUIMIENTOS
### ============================================
GET http://localhost:8004/seguimientos


### ============================================
### 2. FILTRAR POR INCAPACIDAD
### ============================================
GET http://localhost:8004/seguimientos?incapacidad_id=1


### ============================================
### 3. CREAR NUEVO SEGUIMIENTO
### ============================================
POST http://localhost:8004/seguimientos
Content-Type: application/json

{
  "incapacidad_id": 2,
  "fecha": "2026-06-10",
  "comentario": "Seguimiento adicional para validación",
  "estado": "en_revision",
  "usuario_responsable": "admin"
}


### ============================================
### 4. ACTUALIZAR ESTADO
### ============================================
PATCH http://localhost:8004/seguimientos/1/estado
Content-Type: application/json

{
  "estado": "aprobada"
}


### ============================================
### 5. VERIFICAR CAMBIO
### ============================================
GET http://localhost:8004/seguimientos


### ============================================
### 6. PRUEBA DE ERROR - Campo vacío
### ============================================
POST http://localhost:8004/seguimientos
Content-Type: application/json

{
  "incapacidad_id": 1,
  "fecha": "2026-06-10",
  "estado": "registrada",
  "usuario_responsable": "admin"
}