    // GET /incapacidades/empleado/{empleado_id}/activas
    // Verifica si un empleado tiene incapacidades activas (no finalizadas ni rechazadas)
    public function activasPorEmpleado(ServerRequestInterface $request, ResponseInterface $response, array $args): ResponseInterface
    {
        $empleadoId = (int) $args['empleado_id'];
        
        $activas = Incapacidad::where('empleado_id', $empleadoId)
            ->whereNotIn('estado', ['finalizada', 'rechazada'])
            ->orderBy('fecha_inicio', 'desc')
            ->get();
        
        return ResponseHelper::success([
            'empleado_id' => $empleadoId,
            'tiene_incapacidades_activas' => $activas->count() > 0,
            'cantidad' => $activas->count(),
            'incapacidades' => $activas
        ], 'Incapacidades activas consultadas');
    }